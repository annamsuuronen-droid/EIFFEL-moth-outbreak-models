{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EIFFEL: 1 Paivita GitHubista (fast-forward)",
      "type": "shell",
      "command": "git",
      "args": [
        "pull",
        "--ff-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "EIFFEL: 2 Muodosta Saa+Frost ja validoi",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run_eiffel_local_workflow.ps1",
        "-Mode",
        "BuildAndVerify"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "EIFFEL: Paivita + muodosta + validoi (YKSI TEHTAVA)",
      "dependsOn": [
        "EIFFEL: 1 Paivita GitHubista (fast-forward)",
        "EIFFEL: 2 Muodosta Saa+Frost ja validoi"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "EIFFEL: Tarkista viimeisin aineisto ilman uudelleenajoa",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run_eiffel_local_workflow.ps1",
        "-Mode",
        "VerifyLatest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "EIFFEL: Tarkista alkuperaiset pyyntijaksot",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run_eiffel_local_workflow.ps1",
        "-Mode",
        "Audit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "EIFFEL: Aiemmin valitut 13+5 saamuuttujaa (ei esikarsintaa)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run_eiffel_local_workflow.ps1",
        "-Mode",
        "LockedWeather"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
